{
  "name": "gharmap",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gharmap/web",
    "build": "npm run build -w @gharmap/web",
    "build:pages": "npm run build:pages -w @gharmap/web",
    "preview": "npm run preview -w @gharmap/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p apps/web/e2e",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.4",
    "@playwright/test": "1.48.2",
    "@types/node": "20.17.6"
  },
  "overrides": {
    "vite": "5.4.10"
  }
}
